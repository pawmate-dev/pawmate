# HTTP listen port for local development.
PAWMATE_PORT=8080

# Public base URL advertised to clients. Leave empty for local development.
PAWMATE_PUBLIC_URL=http://localhost:8080

# Stable identifier for this private Pawmate instance.
PAWMATE_INSTANCE_ID=pawmate-local
PAWMATE_INSTANCE_NAME=Our Little Home

# development, test, or production.
PAWMATE_ENV=development
